{
  "name": "openchamber-deepseek-usage",
  "version": "0.5.1",
  "private": true,
  "description": "DeepSeek 余额、用量与峰谷计费面板（OpenChamber 扩展）",
  "scripts": {
    "build": "node build.mjs"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.2.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=1.24.1"
    },
    "contributes": {
      "panel": {
        "id": "deepseek-usage",
        "name": "DeepSeek 用量",
        "icon": "icon.svg",
        "entry": "panel/index.html"
      },
      "background": {
        "entry": "background/index.html"
      },
      "page": {
        "entry": "page/index.html",
        "title": "DeepSeek Usage"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "DeepSeek 用量 / Usage",
        "height": 128
      },
      "capabilities": [
        "sessions"
      ],
      "service": {
        "entry": "service/main.js",
        "runtime": "host"
      },
      "actions": [
        {
          "id": "message-cost",
          "label": "本条 DeepSeek 费用 / Message cost",
          "where": "message",
          "mode": "background",
          "roles": [
            "assistant"
          ]
        }
      ],
      "attach": false
    }
  }
}
